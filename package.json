{
  "name": "bike-catalog-mfe",
  "private": true,
  "scripts": {
    "serve:registry": "serve public --cors -l 4000",
    "build:remotes": "pnpm -r --filter '!app-shell' build",
    "build": "pnpm -r build",
    "dev": "pnpm build:remotes && concurrently --names \"REGISTRY,REMOTES,SHELL\" \"pnpm serve:registry\" \"pnpm -r --parallel --filter '!app-shell' preview\" \"pnpm --filter app-shell dev\"",
    "preview": "pnpm build && concurrently --names \"REGISTRY,PKGS\" \"pnpm serve:registry\" \"pnpm -r --parallel preview\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "serve": "^14.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
